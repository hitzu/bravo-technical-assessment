meta {
  name: 20-create (edge - unsupported country BR)
  type: http
  seq: 20
}

post {
  url: {{base_url}}/applications
  body: json
  auth: inherit
}

headers {
  authorization: Bearer {{agent_token}}
}

body:json {
  {
    "countryId": "{{countryId_br}}",
    "fullName": "Ana Silva",
    "documentId": "BR0000000000",
    "monthlyIncome": 25000,
    "requestedAmount": 100000
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

