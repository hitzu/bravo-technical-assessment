meta {
  name: 22-update status (edge - only from IN_REVIEW)
  type: http
  seq: 22
}

patch {
  url: {{base_url}}/applications/{{applicationId}}/status
  body: json
  auth: inherit
}

headers {
  authorization: Bearer {{admin_token}}
}

body:json {
  {
    "status": "APPROVED"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

